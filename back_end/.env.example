# Copy to back_end/.env locally. On the server this file is ~/noree-api/.env. At least one model key is required.
BASETEN_API_KEY=
META_API=

# The 3D service. This default is right for local development and the server.
# SANDBOX_URL=http://127.0.0.1:8000

# Optional limits
# AI_ENABLED=true
# AI_MAX_RUNS_PER_HOUR=120
# GEN3D_MAX_RUNS_PER_HOUR=30

# Optional model overrides
# INK_BASETEN_MODEL=meta-models/muse-spark-open-1026
# INK_META_MODEL=muse-spark-1.3
# INK_META_EFFORT=low
